{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "historik-import",
  "type": "object",
  "additionalProperties": false,
  "required": ["suggestions"],
  "properties": {
    "suggestions": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "quote"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 120 },
          "quote": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
