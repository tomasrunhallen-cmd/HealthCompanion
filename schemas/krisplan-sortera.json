{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "krisplan-sortera",
  "type": "object",
  "additionalProperties": false,
  "required": ["rows"],
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "polarity"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 20 },
          "kind": {
            "type": "string",
            "enum": ["sign", "trigger", "action", "routine", "contact", "value_anchor", "wish", "note_for_care", "ignore"]
          },
          "polarity": { "type": "string", "enum": ["up", "down", "both"] }
        }
      }
    }
  }
}
