# Application
APP_PASSWORD=change_me_to_a_strong_password
SECRET_KEY=change_me_to_64_random_hex_chars
DATABASE_URL=sqlite+aiosqlite:///./data/mood.db

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Garmin Connect (stored encrypted — these seed the first-run setup)
GARMIN_USERNAME=
GARMIN_PASSWORD=
# Fernet master key: generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
GARMIN_ENCRYPTION_KEY=

# CORS (comma-separated, e.g. http://localhost:3000,https://your-domain.com)
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
