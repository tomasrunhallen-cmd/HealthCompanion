{
  "expo": {
    "name": "Dagsljus",
    "slug": "dagsljus",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "se.dagsljus.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Dagsljus använder Face ID för att låsa appen."
      },
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8913A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "se.dagsljus.app",
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Dagsljus",
      "backgroundColor": "#F5F7F2"
    },
    "scheme": "dagsljus",
    "plugins": [
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Dagsljus använder Face ID för att låsa appen."
        }
      ],
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F7F2",
          "dark": {
            "backgroundColor": "#101A16"
          }
        }
      ],
      "expo-font"
    ]
  }
}
